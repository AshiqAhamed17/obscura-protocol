# Copy to .env (gitignored) and fill in. Load with: node --env-file=.env / your shell.
#
# Subgraph Studio API key (Studio -> API Keys). When set, the oracle queries the
# Studio endpoint authenticated. Free tier; NEVER commit the real value.
OBSCURA_API_KEY=

